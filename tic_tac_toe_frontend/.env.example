# Frontend environment example for tic_tac_toe_frontend

# Toggle chatbot widget
REACT_APP_CHATBOT_ENABLED=true

# OpenAI API key for direct frontend calls (Bearer token)
# NOTE: This is for demo/previews only. Do not expose real production keys publicly.
REACT_APP_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI model (defaults to gpt-4o-mini if omitted)
# You may also set gpt-4o-mini-2024-07-18 if needed.
REACT_APP_OPENAI_MODEL=gpt-4o-mini
